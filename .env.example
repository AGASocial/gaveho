# Names only — set real values in Vercel (vercel env pull .env.local for local dev).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site (used for magic-link and Instagram OAuth redirects)
NEXT_PUBLIC_SITE_URL=

# n8n/Telegram agent endpoint (/api/agent) — no longer used for admin login
AGENT_SECRET=

# Vercel AI Gateway (chat, blog generation, Instagram captions). OIDC works on Vercel.
AI_GATEWAY_API_KEY=

# Optional news search for /admin/ideas
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
NEWS_SEARCH_PROVIDER=

# Instagram publishing (/admin/social)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional; defaults to $NEXT_PUBLIC_SITE_URL/api/admin/social/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Optional; defaults to v23.0
INSTAGRAM_GRAPH_API_VERSION=
# 32 random bytes, base64: openssl rand -base64 32
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Vercel Cron auth for /api/internal/*
CRON_SECRET=

# TikTok (Login Kit v2 + Content Posting API Direct Post). See docs/tiktok-setup.md.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional. Defaults to ${NEXT_PUBLIC_SITE_URL}/api/admin/social/tiktok/callback (https://gaveho.com/...). Must match the portal exactly.
TIKTOK_REDIRECT_URI=
# Optional. SELF_ONLY (default) | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | PUBLIC_TO_EVERYONE. Unaudited apps: SELF_ONLY only.
TIKTOK_DEFAULT_PRIVACY_LEVEL=
# Optional. auto (default: PULL_FROM_URL, falls back to FILE_UPLOAD) | pull | file
TIKTOK_UPLOAD_MODE=
